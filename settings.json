  "vim_mode": false,
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview",
    },
  },
  "ui_font_size": 13,
  "buffer_font_size": 12,
  "buffer_font_family": "JetBrains Mono",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "GitHub Dark",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 200,
    },
  },
  "file_scan_exclusions": [
    "**/.ruff_cache",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__",
    "**/*.egg-info",
    "**/.vscode",
    "**/.idea",
    "**/.venv",
  ],
  "restore_on_startup": "last_workspace",
  "base_keymap": "VSCode",
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "soft_wrap": "editor_width",
  "terminal": {
    "font_family": "MesloLGS NF",
    "font_size": 12,
    "blinking": "on",
    "copy_on_select": true,
    "line_height": "comfortable",
  },
  // LSP settings
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true,
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-g", "-r", "%l", "%p", "%f"],
          },
        },
      },
    },
    "tinymist": {
      "settings": {
        "outputPath": "$root/$name",
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 180,
          "lint": {
            "preview": true,
            "extendSelect": ["E", "F", "Q", "B", "S", "I"],
          },
        },
      },
    },
    "ty": {
      "binary": {
        "arguments": ["server"],
      },
    },
  },
  // Language specific settings
  "languages": {
    "C++": {
      "format_on_save": "on",
    },
    "Python": {
      "language_servers": ["ty", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  // Jupyter/REPL settings
  "jupyter": {
    "kernel_selections": {
      "python": "venv",
    },
  },
}

