// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-i": "assistant::InlineAssist",
      "cmd-r": "repl::Restart",
      "ctrl-shift-enter": "repl::Run",
      "ctrl-enter": "repl::RunInPlace",
      "ctrl-c": "repl::ClearOutputs",
      "ctrl-backspace": "repl::Interrupt"
    }
  }
]

